# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # RAHASIA: hanya di server, jangan dibagikan

# --- Halaman admin (scan QR) ---
ADMIN_PASSWORD=                  # wajib, pakai password panjang
PORT=3000
HOST=127.0.0.1                   # ganti 0.0.0.0 bila di server (dan pasang HTTPS!)

# --- Pembatas biaya ---
MAX_REQUESTS_PER_HOUR=30
# Kosongkan = semua nomor boleh. Isi nomor dipisah koma: 6281234567890,6285...
ALLOWED_NUMBERS=

# --- Deploy (docker compose) ---
DOMAIN=admin.contoh.com          # domain yang diarahkan ke IP server
