# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN isi nilai asli di file ini
# (file ini ikut ke GitHub). `.env` sudah diabaikan git.

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Halaman admin (scan QR, lihat pesan) ---
# Wajib, pakai password panjang & acak (jangan nama/tanggal lahir).
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1

# --- Pembatas biaya ---
MAX_REQUESTS_PER_HOUR=30
# Kosongkan = semua nomor boleh. Isi nomor dipisah koma: 6281234567890,6285...
ALLOWED_NUMBERS=

# --- Deploy (docker compose) ---
DOMAIN=admin.contoh.com

# --- Opsional ---
# WA_USER_AGENT=
